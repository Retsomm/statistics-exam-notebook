    "100-2s-34": {
      "questionSha256": "b3f7cc66932a7aa484f738236d2f29f40fca436a381dbef85bbf90442b1b8b3b",
      "explanation": {
        "summary": "傳統單因子ANOVA的精確F檢定假定誤差獨立、各組常態且同變異，但各組樣本數可以不相等。樣本數相等會讓設計較平衡及較穩健，卻不是能否使用此模型的必要條件。",
        "options": {
          "A": "各組人數可不等，因此這是題目所問的非必要條件。",
          "B": "傳統小樣本精確F檢定需常態誤差假設。",
          "C": "傳統合併組內變異數的F檢定假設各組同變異；不同時可考慮Welch方法。",
          "D": "觀察的隨機性及獨立性是有效推論的重要條件。"
        },
        "optionVerdicts": {
          "A": "可以選。",
          "B": "不選。",
          "C": "不選。",
          "D": "不選。"
        },
