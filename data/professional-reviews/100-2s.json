    "100-2s-1": {
      "questionSha256": "67c9c16546cd0d5d7d2dd982b1ab8f02a07156d69baed8b71d27b59e6c198515",
      "explanation": {
        "summary": "題目要找錯誤敘述。順序尺度包含高低先後，名目尺度只有分類；能利用排名的程序，不能直接套在沒有順序的類別上。例如中位數適用順序資料，卻不能對血型取中位數，因此選D。",
        "options": {
          "A": "最小平方法是使殘差平方和最小的代數運算，求係數本身不需常態。",
          "B": "獨立時共變異數為0，Var(X±Y)皆等於Var(X)+Var(Y)。",
          "C": "成對t檢定對每對差值做單樣本t檢定，不要求兩次測量各自變異數相等。",
          "D": "名目資料沒有大小順序，不能沿用需要排序的程序；這是要選的錯誤敘述。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年統計學大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0603&q=1"
          },
