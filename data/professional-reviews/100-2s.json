    "100-2s-18": {
      "questionSha256": "e2c5a2552a17b02e5b58dddde245c213b884b4d62ec12797d8c91ce2c20ef670",
      "explanation": {
        "summary": "判斷錯誤類型時同時看真實情況與決策。虛無假設實際錯誤，而研究者拒絕它，是正確拒絕；在此情況下成功拒絕的機率稱為檢定力1−β，不是第一型或第二型錯誤。",
        "options": {
          "A": "第二型錯誤是H₀錯誤卻未拒絕。",
          "B": "第一型錯誤是H₀為真卻拒絕。",
          "C": "H₀錯誤且拒絕H₀，決策方向正確。",
          "D": "是否錯誤不是依感覺嚴重程度，而是依真實假設與決策的組合。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年統計學大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0603&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0603&q=1"
          }
        ]
      }
