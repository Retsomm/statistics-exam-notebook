    "100-2s-30": {
      "questionSha256": "57720ffd36991c6f91cf35e83d1666d20fa93889f3bda602f97dea0c394e416c",
      "explanation": {
        "summary": "簡單線性迴歸含截距時，R²=r²，因此|r|=√0.81=0.9。相關係數與斜率同號，斜率−1.63是負的，所以r=−0.9。R²本身沒有正負，需由斜率補回方向。",
        "options": {
          "A": "−0.85的平方為0.7225，與0.81不符。",
          "B": "除了大小不符，正號也與負斜率相反。",
          "C": "大小0.9、方向負，兩條條件都符合。",
          "D": "斜率已提供方向，R²已提供大小，可以判斷。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年統計學大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0603&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0603&q=1"
          }
        ]
      }
    },
    "100-2s-31": {
      "questionSha256": "f2cf515b828df3824b8e0ebf218733c0091e3e2d139f2f6848497831bc811210",
      "explanation": {
        "summary": "柴比雪夫不等式適用任何具有有限變異數的分配：距平均不到k個標準差的比例至少1−1/k²。k=2得到1−1/4=3/4=75%。不能把常態分配的68–95–99.7經驗法則當成一般保證。",
        "options": {
          "A": "1−1/2²=75%，是所求的一般下界。",
          "B": "68%對應常態約一個標準差，不是這題的兩倍界限。",
          "C": "95%是常態兩個標準差的近似比例，並非任意分配保證。",
          "D": "89%接近k=3時8/9的下界，不是k=2。"
        },
        "optionVerdicts": {
          "A": "可以選。",
          "B": "不選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年統計學大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0603&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0603&q=1"
          }
        ]
