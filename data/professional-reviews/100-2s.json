    "100-2s-14": {
      "questionSha256": "6a53ceb3947a4b58b90fa9cfb7139318854847fcb223256309abcb81f50fdeed",
      "explanation": {
        "summary": "A可分成互斥的A∩B與A∩Bᶜ，因此P(A∩Bᶜ)=P(A)−P(A∩B)=0.3−0.2=0.1。本題沒有獨立假設，而且0.2不等於0.3×0.4，不能用獨立乘法。",
        "options": {
          "A": "A中扣除與B重疊的部分，剩下0.1。",
          "B": "0.12是P(A)P(B)，但兩事件不獨立。",
          "C": "0.06是0.3×0.2，沒有所需的補集意義。",
          "D": "0.08是0.4×0.2，並非A且非B的機率。"
        },
        "optionVerdicts": {
          "A": "可以選。",
          "B": "不選。",
          "C": "不選。",
          "D": "不選。"
        },
