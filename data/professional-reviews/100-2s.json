    "100-2s-24": {
      "questionSha256": "a75b3c1d6d539b88d6ef37e9ad513f96ca21c2b294b03fe6e0deeeffc49a9a2f",
      "explanation": {
        "summary": "單一解釋變數且含截距的模型，R²=r²=sxy²/(sx²sy²)。代入710.01²/(3.43×203400)≈0.72259，選最接近的0.722。約72%的樣本日支出變異可由此直線關聯解釋，不是72%的支出由人口數「造成」。",
        "options": {
          "A": "0.722最接近計算所得0.72259。",
          "B": "0.851接近相關係數r≈0.850，不是其平方。",
          "C": "0.647小於資料算出的解釋比例。",
          "D": "0.682不是共變異數平方與兩變異數乘積的比值。"
        },
        "optionVerdicts": {
          "A": "可以選。",
          "B": "不選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
