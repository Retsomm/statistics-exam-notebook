    "100-2s-32": {
      "questionSha256": "b53924249264450db8a6699e33c60fc2f2cdab3b1a1307131a30d192834d6b6d",
      "explanation": {
        "summary": "每位工人都使用全部三種工法，先以工人作為區集，控制熟練度等個人差異，再在每個工人內隨機安排工法順序，所以是隨機集區設計。六人是六區集，三種工法是處理。",
        "options": {
          "A": "完全隨機分派會忽略工人差異，與同一人試遍工法的安排不同。",
          "B": "可用二因子無重複的模型分析，但設計目的明確是用工人作區集控制差異。",
          "C": "巢型要求某因子層級只出現在另一層級內，三種工法在每人都出現並非巢型。",
          "D": "工人作區集、區集內隨機安排工法，正符合此設計。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
