    "100-2s-6": {
      "questionSha256": "8ec7496f3572ed20d074cf8206e82a32b4a0966971f58f45ebf54d80f6acf2cc",
      "explanation": {
        "summary": "先把A拆成A∩B與A∩Bᶜ，得到P(A)=0.2+0.3=0.5。A與B獨立也表示A與Bᶜ獨立，所以P(A∣Bᶜ)=P(A)=0.5；不能把交集機率0.3當作條件機率。",
        "options": {
          "A": "0.06只是0.2與0.3的乘積，並無對應的條件機率公式。",
          "B": "0.1不是P(A)，也不是正確的分母調整結果。",
          "C": "0.94沒有由交集、補集或獨立關係推出。",
          "D": "由獨立性直接得到P(A∣Bᶜ)=0.5。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年統計學大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0603&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0603&q=1"
          }
        ]
      }
    },
    "100-2s-7": {
      "questionSha256": "8c8ec895f73ea71d2f4073366e43bcaf2afb8d07b3102a847cd1bed144dce11d",
      "explanation": {
        "summary": "由獨立性，P(A)=P(A∣Bᶜ)=0.5；再由補集得P(B)=1−0.2=0.8。因此P(A∩B)=0.5×0.8=0.4。先辨明題目給的是B的補集，才不會錯乘0.2。",
        "options": {
          "A": "0.1是P(A∩Bᶜ)，不是題目所問的A∩B。",
          "B": "0.3是0.5−0.2，兩個不同事件機率不可這樣相減。",
          "C": "交集機率為P(A)P(B)=0.5×0.8=0.4。",
          "D": "0.5只有A的邊際機率，尚未限制B也發生。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年統計學大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0603&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0603&q=1"
          }
        ]
      }
    },
    "100-2s-8": {
      "questionSha256": "357519c926e15022fafe87f6b14f0cb66cabc53c52e63c0c53adeff7fe284366",
      "explanation": {
        "summary": "10次罰球次數固定，每次只有中與不中、命中率都是0.9，且各次獨立，因此命中次數X服從Binomial(10,0.9)。二項分配的四個要素在題目中都已具備。",
        "options": {
          "A": "卜瓦松常描述固定時間的事件次數，並不是本題固定10次試驗的精確模型。",
          "B": "常態是連續分配，最多作近似；此處不中的期望次數只有1。",
          "C": "超幾何對應有限母體不放回抽樣，這裡各罰球獨立。",
          "D": "固定次數、二元結果、固定成功率與獨立性符合二項模型。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年統計學大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0603&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0603&q=1"
          }
