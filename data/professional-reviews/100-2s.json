    "100-2s-5": {
      "questionSha256": "3a087bb18dc6a904f0d18b274c7695b5148eb20a6d3d8389efbd3294b0d4a96a",
      "explanation": {
        "summary": "抽樣單位是班級，抽到班級後調查全班學生，這是一階段集群抽樣。辨識重點是先抽整群、再全查群內；若每班各抽一些學生且所有班都參與，才接近以班級分層的設計。",
        "options": {
          "A": "不是直接從全臺學生名冊抽個別學生。",
          "B": "沒有從每個班級各抽學生；只有抽中的50班受訪。",
          "C": "班級就是集群，入選集群內所有學生都調查。",
          "D": "未按固定間隔如每第20位學生選取。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年統計學大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0603&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0603&q=1"
          }
        ]
      }
