    "100-2s-2": {
      "questionSha256": "10c10ec7798631e2980450af22e3890a900e77d934f85f6672b0de92c5bca01e",
      "explanation": {
        "summary": "集群抽樣先抽學校、班級或地區等群，再調查群內單位，可以集中訪查路線及作業，主要節省成本、增加便利。群內相似造成的群聚相關，反而可能降低精確度，不能把便利與精確混為一談。",
        "options": {
          "A": "群內單位可能相似，並不保證估計比簡單隨機抽樣精確。",
          "B": "一次訪查整群可減少交通與聯繫成本，是此設計的主要優點。",
          "C": "群聚相關通常使變異數估計更複雜，不是分析最簡單。",
          "D": "信賴區間需正確考慮抽樣設計，集群本身不保證涵蓋率更準。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年統計學大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0603&q=1"
          },
