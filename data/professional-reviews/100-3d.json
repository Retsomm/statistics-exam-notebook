    "100-3d-46": {
      "questionSha256": "b267c5c13654948f282e634258919ead03c6fcec3a1eacf931619bfafd2bd52e",
      "explanation": {
        "summary": "傳統防火牆依來源、目的、連接埠、連線狀態或應用代理規則決定允許流量；封包加密主要是VPN等機制的工作，所以通常選B。現代整合設備可能兼具VPN與加密，不能因此宣稱任何防火牆都無法加密。",
        "options": {
          "A": "應用代理可在應用層中介及檢查流量，是一類防火牆機制。",
          "B": "加密不是基本流量存取控制的必要功能，雖可整合在同設備。",
          "C": "封包過濾是防火牆的基本實作方式。",
          "D": "依連線狀態或類型過濾，也屬常見防火牆功能。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
