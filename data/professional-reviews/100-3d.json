    "100-3d-29": {
      "questionSha256": "e02c66b89e9072d00c291ed3d3c428584017cc37f4a47dbecd6d35fbdce373fe",
      "explanation": {
        "summary": "400MIPS表示平均每秒4×10⁸條指令，單條平均時間是倒數1/(4×10⁸)=2.5×10⁻⁹秒=2.5ns。這是依整體吞吐量換算的平均，不能推論每一種指令延遲都相同。",
        "options": {
          "A": "0.25ns對應每秒40億指令，比題目快10倍。",
          "B": "1秒除以4億等於2.5ns。",
          "C": "4ns對應每秒2.5億指令，不是400MIPS。",
          "D": "250ns對應4MIPS，比題目慢100倍。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-30": {
      "questionSha256": "f6ca058f226bdc7624fd655d771e7b390e03805c371ac2282eb4550b52e28059",
      "explanation": {
        "summary": "編譯器把高階原始碼轉成目標碼，目標可為機器碼、組合語言或中介表示；在題目的機器碼轉換情境選B。組譯、連結與載入是不同階段，不能只因都參與執行程式就當作編譯器。",
        "options": {
          "A": "組譯器主要把組合語言轉成機器碼，不直接處理一般高階語言。",
          "B": "編譯器負責高階語言的翻譯與分析。",
          "C": "連結器合併目的檔與函式庫並解析符號參照。",
          "D": "載入器把程式映入記憶體及準備執行。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
