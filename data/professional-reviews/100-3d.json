    "100-3d-35": {
      "questionSha256": "fe340740cead006e9874561a98b8743aea3edddcf58a36f489f9082d00921d7a",
      "explanation": {
        "summary": "Wang@mail.moex.gov.tw是電子郵件地址，嚴格說不具scheme的它不是一般網頁URL。@前Wang是本地信箱名稱，後方mail.moex.gov.tw是郵件網域；mail只是網域標籤，不能逕自解釋為收信網頁名稱，因此B錯。",
        "options": {
          "A": "Wang是此郵件地址@前的本地部分，通常對應帳號或別名。",
          "B": "mail是網域中的一個標籤，不代表特定收信網頁。",
          "C": "gov是政府機關用途的網域分類標籤。",
          "D": "moex.gov.tw是此層級的網域名稱，前方還可有子網域。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
