    "100-3d-19": {
      "questionSha256": "3ecbdd39ada5694b9569d0f257b378645cf3fff6d307b60e686f781db794f885",
      "explanation": {
        "summary": "位址數為2的位元數次方，所以IPv6與IPv4理論位址空間之比是2¹²⁸/2³²=2⁹⁶。128/32=4只是位址欄位長度之比，不能當可表示數量之比；實際可分配位址還受保留用途限制。",
        "options": {
          "A": "4只比較位元長度128/32，不是位址數量。",
          "B": "96是指數相減後的指數，還需取2的96次方。",
          "C": "24沒有對應兩種位址空間的比值。",
          "D": "指數法則給出2^(128−32)=2⁹⁶。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-20": {
      "questionSha256": "c747ea5c7a33477cabaefa693638a504d8ed97e9fab3db5df6f16a8fd2535cac",
      "explanation": {
        "summary": "數位簽章由寄件者私鑰簽署，收件者用經可信方式取得的公鑰驗證，可檢查內容完整性與簽署者身分。它不自動隱藏內容，公鑰與身分的可信綁定也是必要前提，因此選C。",
        "options": {
          "A": "加密主要提供機密性，單靠加密不一定能證明發信者身分。",
          "B": "已讀或開啟標幟是追蹤閱讀狀態，不是密碼學身分證明。",
          "C": "以可信公鑰驗章可驗證簽署者及內容是否被改動。",
          "D": "防火牆過濾連線，不會替每封郵件提供寄件者簽章。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
