    "100-3d-1": {
      "questionSha256": "f6bb8918d4a7562757f84d027a04df820943e47de840cc8ac9ec3c582dff4c17",
      "explanation": {
        "summary": "電腦開機時由韌體先決定從哪個裝置讀取開機程式，所以要調整BIOS的Boot順序，把光碟機排在硬碟之前。現代UEFI也有對應設定；能否成功還取決於光碟是否可開機及裝置支援。",
        "options": {
          "A": "控制台是在Windows啟動後執行，不是韌體的開機裝置選擇。",
          "B": "BIOS的Boot裝置優先序決定先嘗試哪個媒體。",
          "C": "啟動資料夾控制登入後自動執行的程式，與開機媒體不同。",
          "D": "主機板跳線常用於清除設定等工作，不是一般設定光碟開機的介面。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-2": {
      "questionSha256": "489e8f4e75f308af6786794becbeaf73dfb006f16afdef209440bad63cbbc9d3",
      "explanation": {
        "summary": "題目比較是否得到權利人授權。依授權範圍使用或引用著作，原則上不是侵權，所以選D。其餘選項涉及盜版營利、未授權重製物輸出或公開上映；仍須依實際授權、法定例外與當時法律認定，不能把所有引用都一概視為需事前同意。",
        "options": {
          "A": "明知盜版仍營利使用，屬原題列舉的侵權情形。",
          "B": "未授權重製物的輸出涉及著作權保護，不能因移到境外就視為合法。",
          "C": "租到影片通常只取得私人觀看資格，未當然取得公開上映授權。",
          "D": "在權利人同意的範圍內引用，具有合法授權依據。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-3": {
      "questionSha256": "5c51a599eff2440a397814dc56e541a5771c63899222f82395f776346cd88db4",
      "explanation": {
        "summary": "本題以當年手機的無線上網方式分類：GSM行動數據、WLAN及具數據服務的PHS都可連網，乙太網路通常指有線區域網路，因此官方選A。但「無法完成」過於絕對，現代手機可透過相容的USB乙太網路轉接器上網，不能當成永久硬體限制。",
        "options": {
          "A": "傳統有線乙太網路不是題目列的手機無線接取系統；有線轉接上網則另當別論。",
          "B": "GSM系統可搭配GPRS等數據服務接取網際網路。",
          "C": "手機可透過Wi-Fi無線區域網路上網。",
          "D": "當時PHS亦有數據接取服務，並非只能通話。"
        },
        "optionVerdicts": {
          "A": "可以選。",
          "B": "不選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-4": {
      "questionSha256": "1d86c30959e7ce0b6fa071cef177688e96061b095930d9faca786e5a0dfcfa47",
      "explanation": {
        "summary": "這題問錯誤敘述，Windows 7的觸控可在支援硬體上操作小畫家，手指也能畫圖，所以D錯。A、B應放在微軟Windows版本演進的脈絡理解，不能擴張成全球所有作業系統都到Windows 7才支援多點觸控。",
        "options": {
          "A": "就當年Windows版本比較，較早版本內建觸控整合程度有限。",
          "B": "官方以Windows 7整合Windows Touch為脈絡，並非宣稱它是全球第一個多點觸控系統。",
          "C": "雙指張開是常見放大手勢，需硬體及程式支援。",
          "D": "小畫家可以接收觸控繪圖，不存在題目所說的例外。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "Microsoft Windows 7觸控設計",
            "url": "https://learn.microsoft.com/en-us/windows/win32/uxguide/inter-touch"
          }
        ]
      }
    },
    "100-3d-5": {
      "questionSha256": "ebcd299c73edfb5f82acfc4211ff2300880df47abf5c8816deef82335b0ca33a",
      "explanation": {
        "summary": "IP位址用於網路層定址與路由，所以四項中選C。不過原題「每部電腦全球唯一」是教科書簡化：私人IP可在不同內網重複，NAT可共用公網IP，一部主機也可有多個IP；全球可路由位址的唯一性不等於每台電腦固定一個公網IP。",
        "options": {
          "A": "電子郵件地址識別信箱，不是每台連網設備的網路層識別。",
          "B": "多個網域可指向同一IP，主機也不一定有網域名稱。",
          "C": "IP負責網路層位址；須區分私人位址與全球可路由位址。",
          "D": "電腦名稱可能在不同網路重複，並非全球唯一的路由位址。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-6": {
      "questionSha256": "3da726083e581bab3f77f5d78cfe69eec842779896a539676d57f4afe9ac2cfc",
      "explanation": {
        "summary": "雙引號使內容成為字串，不是日期或數值。\"8/25\"與\"12/25\"先比首字元8和1，通常文字排序下8較大，所以小於比較為False。中文字排序會受地區設定影響，本題其餘文字比較依當年Excel預設排序解讀。",
        "options": {
          "A": "官方採用的文字排序中中文排在英文字母之後；跨地區設定不宜當普遍字元碼定理。",
          "B": "作文字比較時首字元8大於1，所以此小於式為False。",
          "C": "前三字元100相同，下一字元公與0比較，在本題排序中前者較後。",
          "D": "首字母d排在g前面，這個小於式為True。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-7": {
      "questionSha256": "4b333864c0387e15d43c33f13e9253724b0966ae27128bc059ec8b2e6d1911c6",
      "explanation": {
        "summary": "一張資料表至多指定一個PRIMARY KEY約束，但這個主鍵可包含多個欄位；同時可能有多個候選鍵或UNIQUE約束。把「多個欄位」誤當「多個主鍵」，就是D的問題。SQL也允許沒有宣告主鍵的表。",
        "options": {
          "A": "實務SQL允許建立未指定PRIMARY KEY的資料表。",
          "B": "主鍵必須唯一且不能為NULL，才能識別每列。",
          "C": "例如選課表可用學號與課號組成複合主鍵。",
          "D": "同表不能宣告多個PRIMARY KEY；多個候選鍵不等於多個主鍵。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-8": {
      "questionSha256": "dc4a65b0ce1aee373eaebb1889661b89f76869689f54004f6c49101d65d992d2",
      "explanation": {
        "summary": "一般電子郵件由用戶端提交給寄件伺服器，再由伺服器投遞到收件端郵件伺服器，收件人以IMAP、POP或網頁讀信，符合C。這是典型流程，伺服器可能合併部署，收件人也不必當時開機。",
        "options": {
          "A": "收件電腦可能離線，郵件通常先存於收件伺服器。",
          "B": "漏掉一般寄件提交伺服器的步驟。",
          "C": "依寄件提交、伺服器投遞及收件存取分段，符合典型流程。",
          "D": "通常仍要經收件信箱伺服器保存及提供存取。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-9": {
      "questionSha256": "1aabf6f3374281cdab5ba57cb44a075e430036559e29811a918734057ae976fd",
      "explanation": {
        "summary": "都會網路MAN連接同一城市或都會區內的多個區域網路，因此城市行政機關互連最符合B。LAN、MAN、WAN按涵蓋範圍分類；Ethernet則是網路技術，不能直接拿來當相同層次的範圍名稱。",
        "options": {
          "A": "區域網路通常限建築物或較小校園，範圍比整個城市小。",
          "B": "MAN以都會區為典型範圍，可連接各行政單位LAN。",
          "C": "WAN涵蓋較廣地域甚至跨國，並非此題最貼切名稱。",
          "D": "乙太網路是一種連線技術，不是城市範圍的分類名稱。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-10": {
      "questionSha256": "017818016a53690f2f022230a790a61bcc608579d6b02b0391e572cf9ecfa65e",
      "explanation": {
        "summary": "資料庫系統除了資料表，還有結構定義、關聯約束、查詢、交易與權限管理等，所以「只是一些資料表格」過於片面，選A。B、C是理論關聯模型的集合與屬性概念；實際SQL若未設限制，可能保留重複列，不能把理論保證誤當SQL自動行為。",
        "options": {
          "A": "忽略DBMS、約束及交易等管理功能，因此是要找的錯誤敘述。",
          "B": "理論關聯是列的集合而無重複；SQL表仍需鍵或UNIQUE約束才能強制。",
          "C": "理論上各屬性須有明確名稱與值域，不能出現重複屬性名稱。",
          "D": "一個資料庫可包含一張或多張資料表，並建立關聯。"
        },
        "optionVerdicts": {
          "A": "可以選。",
          "B": "不選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-11": {
      "questionSha256": "db25b207fe48e5c9efc8074fd8f13ef36225175356e4215b7fdd65b918bbf43d",
      "explanation": {
        "summary": "GPS接收衛星訊號，利用時間與軌道資料計算位置，基本定位不需要Internet，所以選C。地圖下載、輔助定位可以用網路，但那不等於衛星定位本身是Internet服務。",
        "options": {
          "A": "遠距教學可透過Internet提供影音、教材與互動。",
          "B": "FTP是Internet協定套件中的檔案傳輸服務。",
          "C": "衛星定位的核心訊號來自導航衛星，而非Internet伺服器。",
          "D": "Telnet或SSH等可在Internet上提供遠端登入。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-12": {
      "questionSha256": "968bab8cabf0f10560ad22305da293698769a9569db68da3b8cdcae25eaa5001",
      "explanation": {
        "summary": "二分搜尋每次比較後約把候選範圍減半，最壞成功搜尋比較次數為⌊log₂n⌋+1。因2¹⁰=1024<1500<2048=2¹¹，所以最多11次；前提是姓名已排序且採相應比較規則。",
        "options": {
          "A": "8次只能涵蓋至多2⁸−1=255個搜尋樹節點。",
          "B": "11層比較足以涵蓋1500項，是最壞情況上限。",
          "C": "750近似一次減半後的資料量，不是比較次數。",
          "D": "1000忽略二分搜尋的對數成長特性。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-13": {
      "questionSha256": "43dbcee4f621dc47507fc5735ec0613444d7a2d6556f8ecb54b838b072a64921",
      "explanation": {
        "summary": "存取管制是辨認誰能對哪些資源做哪些操作，需要身分驗證及權限設定。題目的「控制碼」可理解為密碼或存取憑證，C符合提供授權設定的方向，但僅有密碼還不足以涵蓋完整存取管制。",
        "options": {
          "A": "完全斷網會失去網路功能，並非存取管制的定義或必要手段。",
          "B": "任何存取都可能涉及機密性及權限，不能不考慮安全。",
          "C": "提供憑證與權限設定，是限制未授權存取的基本機制。",
          "D": "為方便取消存取控制，會讓未授權者也能取得資源。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
