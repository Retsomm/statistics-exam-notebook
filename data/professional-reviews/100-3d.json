    "100-3d-27": {
      "questionSha256": "8c05773fa9cc6e3bb271d01e62ee023d340f2928716ba0630b32a686db1f3223",
      "explanation": {
        "summary": "後序式遇數字入堆疊，遇運算子就取出右、左兩運算元。依序得到(1−(2+3)×4)−((5+6×7)−8×9)=−19−(47−72)=6。減法的左右順序不能交換。",
        "options": {
          "A": "2不是依此運算子順序逐次出堆疊的結果。",
          "B": "左大項−19、右大項−25，相減得到6。",
          "C": "−2不是正確的減法運算元次序所得結果。",
          "D": "−48未依原式完整保留兩個最外層減法。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
