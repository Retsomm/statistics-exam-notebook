    },
    "100-3d-47": {
      "questionSha256": "7e5125827e585549d901c39656397159c4d4243b7fe5800940c4b9a7773ad3b0",
      "explanation": {
        "summary": "逐位元OR只要任一位是1就得到1。11110000 OR 10101010=11111010₂，換十進位為128+64+32+16+8+2=250，所以選C。FA則是同一結果的十六進位寫法，題目明確要十進位。",
        "options": {
          "A": "87不是這兩個位元組OR後的十進位值。",
          "B": "FA₁₆等於250₁₀，但表示法不符合題目指定的十進位。",
          "C": "11111010₂換成十進位正是250。",
          "D": "372超過8bit無號數最大255，不可能是此結果。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-48": {
      "questionSha256": "b64f4f88250dce64cc6fc4a3bd9b24c3e47082be49ea739f2a593da431f8a26b",
      "explanation": {
        "summary": "先把不同進位制轉成相同基底。70₈=7×8=56，11110₂=16+8+4+2=30，相減為26₁₀，再轉十六進位是1A，所以選B。不能直接把70與11110當十進位相減，也要讀清楚每個選項標示的基底。",
        "options": {
          "A": "11000₂等於24，不是正確差26。",
          "B": "1A₁₆=16+10=26，符合56−30。",
          "C": "40₁₀比正確差26大14。",
          "D": "34₈等於28，正確差若用八進位應為32₈。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-49": {
      "questionSha256": "8a419bcac49c3cef88f35adf0aa2174850a7dcbac6a43cb494b7d41ed06d4ab4",
      "explanation": {
        "summary": "原卷第49題討論行程遷移：①移出過載主機可減少排隊，②相關行程集中可減少跨機通訊，③移向穩定主機可改善可用性，三項皆可能成立，故選D。效益仍需扣除遷移、資源競爭及故障集中等成本。",
        "options": {
          "A": "③可能成立，但①②也有合理改善機制，不能只選③。",
          "B": "①②可改善效能，但不能排除③提升可用性。",
          "C": "②③成立，①從過載主機移出也可能有效。",
          "D": "三種情況都可能有益，正確包含①②③。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
