    "100-3d-33": {
      "questionSha256": "a4f85e51adaed34c87749d67962abf3d7d9cc6dd948126315d0cf14049591450",
      "explanation": {
        "summary": "批次處理將一段時間累積的資料集中處理，不要求每筆立即回應。花博人數周報可在週期結束後統一彙整，符合B；提款、訂票與交易則需即時查核及更新狀態。",
        "options": {
          "A": "提款要即時驗證餘額及扣款，避免帳務錯誤。",
          "B": "周報按週彙總累積人數，可安排批次產生。",
          "C": "訂位需即時確認座位是否被其他人訂走。",
          "D": "股票交易需依市場規則即時處理委託與成交。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
