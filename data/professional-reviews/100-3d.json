    "100-3d-34": {
      "questionSha256": "747962e56caa6fa9fb61e34aed0907656a84a70e275142406b28c61587e66312",
      "explanation": {
        "summary": "DNS提供名稱解析，查詢完整網域名稱對應的A或AAAA等紀錄，才能取得IP位址，所以選C。同一名稱可有多個位址，也可透過別名間接解析，不是永遠一對一。",
        "options": {
          "A": "代理伺服器代用戶轉送請求，並非名稱解析服務本身。",
          "B": "Web伺服器回應HTTP內容，不是其核心職責把名稱轉成IP。",
          "C": "DNS伺服器查詢及回覆名稱與位址等紀錄。",
          "D": "郵件伺服器處理郵件傳遞與儲存，通常也會使用DNS。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
