    "100-3d-37": {
      "questionSha256": "152840b2beba917a5077ddbade36ad9e611756317c6b7ab32b0efc977e47344b",
      "explanation": {
        "summary": "官方答案63對應「根高度為0、每層都滿」的完美二元樹：1+2+4+8+16+32=63。原題使用complete卻未說滿，嚴格的完全二元樹最後一層可未滿，高度5時可有32至63節點，並非唯一63；高度若以層數算也會不同，應記住此命題前提。",
        "options": {
          "A": "64超過根高度0、最高到第5層的最大63節點。",
          "B": "31是根高度4的完美二元樹，或五層計數慣例的結果。",
          "C": "25不足以讓根高度0的完全二元樹達到高度5。",
          "D": "63是高度5的滿層上限；官方將complete按每層全滿解讀。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
