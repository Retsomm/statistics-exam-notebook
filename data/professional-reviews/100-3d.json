    "100-3d-38": {
      "questionSha256": "b9038baf3109454b53377d862547a57fa6ce7248d6e0c7a212fe3f93b79f3bcb",
      "explanation": {
        "summary": "在一般記憶體階層中，暫存器與快取速度快但每bit成本高，主記憶體次之，磁碟大量儲存的每bit成本較低，所以選B。題目比較的是單位容量價格，不是整個設備的總價。",
        "options": {
          "A": "主記憶體通常每bit比磁碟昂貴，但存取更快。",
          "B": "磁碟適合大容量保存，典型每bit成本最低。",
          "C": "快取常用較昂貴的高速SRAM，不能以總容量小誤判便宜。",
          "D": "暫存器直接位於CPU內，單位容量成本極高。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-39": {
      "questionSha256": "b5399075bde1ba22850f8eef9d362c454e1d068e56c7f2687879a9a157ad2245",
      "explanation": {
        "summary": "一般HTTP瀏覽可能先用DNS查網域，傳統DNS可用UDP，之後HTTP經TCP/IP傳輸。SMTP是寄信協定，此次網頁請求通常用不到，選B。若DNS已快取也可能不產生UDP封包，但不改變四項中SMTP與此流程最無關。",
        "options": {
          "A": "題目明示http網址，頁面請求會使用HTTP。",
          "B": "SMTP負責電子郵件傳遞，不是一般瀏覽網頁所需協定。",
          "C": "未快取時DNS查詢可能使用UDP；並非每次都一定用到。",
          "D": "跨網路封包傳送依賴IP定址與路由。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-40": {
      "questionSha256": "82d70ede37e04fb70afdae20a632977fb49ecbe6e1cbde353db431d842968d33",
      "explanation": {
        "summary": "霍夫曼法每次合併最小權重：10+14=24、16+18=34、24+34=58、42+58=100，因此z長1bit，其餘各3bit。平均碼長0.42×1+0.58×3=2.16bit，選C；四組均需先檢查前綴性，再比較加權長度。",
        "options": {
          "A": "平均碼長2.34bit，雖可解碼但高於2.16。",
          "B": "平均碼長2.80bit，把最短碼給低機率v，效率不佳。",
          "C": "最高頻z用1bit，其餘3bit，平均2.16bit最短。",
          "D": "平均碼長2.68bit，把短碼給x而非最高頻z。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-41": {
      "questionSha256": "104b3feb2268cca412866346eb055b3cd004414ab2653ca48fdf41976e7f2df5",
      "explanation": {
        "summary": "插入後根4，左3再接2，右6接5、8，共三層。內部節點4、3、6有3個，葉節點2、5、8也有3個，所以①②真。再插入7須成為8的左子，增加第四層，因此③假。",
        "options": {
          "A": "①搜尋既有鍵走1至3個節點，②內部與葉各3個，皆成立。",
          "B": "③不成立，因7會落在8之下形成新層。",
          "C": "②成立但③錯誤，不能合選。",
          "D": "包含錯誤的③，因此三者全選不成立。"
        },
        "optionVerdicts": {
          "A": "可以選。",
          "B": "不選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-42": {
      "questionSha256": "f03930b5d85e6fd17e0c3ce536e4d46bce8e30945f37511850e99f7db86608c2",
      "explanation": {
        "summary": "第二正規化排除非鍵屬性對候選鍵的部分依賴，但仍可能有非鍵屬性間的遞移依賴。例如學號→系號→系名，單一鍵的學生表可符合2NF，卻需再拆表改善3NF，所以D正確。",
        "options": {
          "A": "單一主鍵仍可能有學號→系號→系名的遞移依賴，不保證3NF。",
          "B": "3NF先滿足2NF，不應再有違反2NF的非鍵部分依賴。",
          "C": "複合鍵正是需檢查部分依賴的情形，不能直接保證2NF。",
          "D": "2NF尚未排除所有遞移依賴，因此仍可能存在。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-43": {
      "questionSha256": "ea088b57f0567478dc30349a5f8074cb3c6982a7496cd8d61673065c930be518",
      "explanation": {
        "summary": "本題的key應按能唯一識別資料列的候選鍵或主鍵理解，其核心特性為唯一性，選C。中文「索引鍵」容易混淆：一般非唯一索引可含重複值，並非所有建立索引的欄位都唯一。",
        "options": {
          "A": "安全性須靠權限與加密等措施，不是鍵值的識別定義。",
          "B": "緊湊有助索引效率，但不是所有鍵的必要邏輯特性。",
          "C": "候選鍵的值能唯一識別一列，才是此處預期的key概念。",
          "D": "可逆性不是資料庫候選鍵的定義要求。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-44": {
      "questionSha256": "b9a969e81c2e02dfac24198fd00cf20509169c98d7a94d3b81c6159e5e50a33b",
      "explanation": {
        "summary": "官方以傳統COBOL的程序式商業資料處理分類選B。但COBOL標準後來已有物件導向擴充，早在此考試前也已出現，因此不能概括說所有COBOL都不支援物件導向；本題需限定傳統COBOL語法及教科書分類。",
        "options": {
          "A": "Java以類別、物件與介面等提供物件導向功能。",
          "B": "傳統COBOL按程序式語言分類；現代物件導向COBOL是本題未區分的例外。",
          "C": "C++支援類別、繼承及多型，也同時支援其他範式。",
          "D": "C#具有完整類別、介面與物件導向機制。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "IBM COBOL物件導向語法",
            "url": "https://www.ibm.com/docs/en/cobol-zos/6.3.0?topic=structure-cobol-class-definition"
          }
        ]
      }
    },
    "100-3d-45": {
      "questionSha256": "918035eab19137d29177e55b06c2ddbcba432f93fbdd6541819d66b8c7a3e48d",
      "explanation": {
        "summary": "第三代語言通常指較接近問題描述的高階語言；組合語言以助記符對應機器指令，通常歸為第二代，所以C不是第三代。這種世代分類是抽象層級的教學分類，不是語言發明時間的先後排序。",
        "options": {
          "A": "Java屬高階語言，依此分類列為第三代。",
          "B": "C雖能操作底層記憶體，仍屬高階第三代語言。",
          "C": "組合語言直接反映指令集，通常歸第二代。",
          "D": "COBOL是商業用途高階語言，屬第三代。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
