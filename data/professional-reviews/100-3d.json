    "100-3d-25": {
      "questionSha256": "bd190d36da14d3623560e60fdddb83d64b88532a328692cdabb210c687625f10",
      "explanation": {
        "summary": "下載容量用Byte，ADSL速率的2M通常指2Mbit/s，先乘8換成位元。以二進位512MiB、速率2Mbit/s計約2147秒即35.8分鐘，加上協定開銷後最接近40分鐘。採十進位512MB則約34.1分鐘，也選A。",
        "options": {
          "A": "換算後理論約34至36分鐘，四項以40分鐘最近。",
          "B": "忽略Byte與bit的8倍差會嚴重低估時間。",
          "C": "1小時大於本題理論值，並非最接近選項。",
          "D": "3小時遠高於2Mbit/s下傳送此容量所需時間。"
        },
        "optionVerdicts": {
          "A": "可以選。",
          "B": "不選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
      }
    },
    "100-3d-26": {
      "questionSha256": "8fc993543136f8fea1ba6d88077de4a3802d5319f3d046f8cabdfc292f60f7d9",
      "explanation": {
        "summary": "深度優先搜尋會先沿一條路徑深入，走不下去再回到最近尚有未探訪分支的節點，符合後進先出的堆疊。遞迴DFS則由呼叫堆疊保存回溯狀態；廣度優先才典型使用佇列。",
        "options": {
          "A": "先進先出的佇列較適合逐層擴展的BFS。",
          "B": "鏈結串列可實作堆疊，但單指一般串列不直接表達DFS回溯順序。",
          "C": "後進先出可讓最近深入的節點先回溯。",
          "D": "BST依鍵值維持搜尋順序，不是一般圖DFS的必要工作結構。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
