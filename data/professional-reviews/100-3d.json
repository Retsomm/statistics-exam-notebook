    "100-3d-32": {
      "questionSha256": "5bafeb0c5285e7e9431eef18d701eaf2b72e62f44bb50c41a0804d1963e26546",
      "explanation": {
        "summary": "依當年典型設備，RAM最快，一般硬碟循序存取通常快於廉價USB隨身碟，所以官方選B。但題目未指定介面、隨機或循序存取及產品，這不是普遍排名；現代高速快閃裝置、SSD可能遠快於機械硬碟。",
        "options": {
          "A": "RAM最快沒錯，快閃與硬碟誰快仍依產品及工作負載而定，不是當年預期順序。",
          "B": "符合本題當年一般RAM、硬碟、廉價隨身碟的預期比較。",
          "C": "硬碟通常遠慢於主記憶體，不能排在RAM前。",
          "D": "一般隨身碟不會比RAM更快，最後一名RAM也不合理。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
          {
            "title": "考選部標準答案",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=100010&c=508&s=0703&q=1"
          }
        ]
