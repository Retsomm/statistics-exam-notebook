    "100-3d-28": {
      "questionSha256": "119b3c95777b394237f2713467a2c43cb9878f1e986e59c6468a7a88fd5f9051",
      "explanation": {
        "summary": "ORDER BY Name省略方向時預設ASC，表示升冪；要降冪必須寫DESC。因此D對查詢效果的解釋錯誤。C的>10且<20不包含兩端，閱讀「介於」時應注意嚴格不等號，而非自動當作BETWEEN。",
        "options": {
          "A": "DISTINCT會移除查詢結果中重複的Name值。",
          "B": "等號條件挑出City值符合新北市的列，字串空白處理仍依實際資料與方言。",
          "C": "嚴格選出ID大於10且小於20的列，不含10及20。",
          "D": "省略ASC/DESC時通常為升冪，不是降冪。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "不選。",
          "D": "可以選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
