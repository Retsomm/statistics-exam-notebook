    "100-3d-21": {
      "questionSha256": "693c75279ab513f383130cc92bf4b3f3786d52f20b203628473fe3f34bf7f019",
      "explanation": {
        "summary": "2.4GHz表示每秒約2.4×10⁹個時脈週期。每週期完成多少指令會因架構、指令及平行執行而異，所以不能直接當每秒程式數、資料筆數或記憶體容量。頻率只是效能因素之一。",
        "options": {
          "A": "每週期存取筆數取決於記憶體與架構，不能直接等同頻率。",
          "B": "GHz是每秒十億週期，2.4GHz即每秒24億週期。",
          "C": "一個程式含大量指令，無法由時脈直接換算程式數。",
          "D": "容量以位元組計算，GHz是頻率單位而非容量。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "可以選。",
          "C": "不選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
