    "100-3d-50": {
      "questionSha256": "b34d1f99a0cc33c5f0700a111360ccd906dbf73a6b6612d06ff63db5df772f62",
      "explanation": {
        "summary": "資料加入與刪除都在同一端，最後加入的元素會最先移除，符合堆疊的後進先出LIFO。所謂頭端只是實作上的命名，改稱頂端更常見；若一端入、另一端出才是佇列。",
        "options": {
          "A": "鏈結串列是儲存結構，可實作多種操作規則，不直接限定同端進出。",
          "B": "搜尋樹依鍵值組織分支，不以同端插入刪除定義。",
          "C": "同端push與pop形成後進先出的堆疊。",
          "D": "佇列通常一端加入、另一端移除，形成先進先出。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
          {
            "title": "100 年資料處理大意官方試題",
            "url": "https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=100010&c=508&s=0703&q=1"
          },
