    "100-3d-31": {
      "questionSha256": "60960f3a2235842e8da44bf81d5a47f7c9e204acad2d5d5c5fd9970f81e0c84f",
      "explanation": {
        "summary": "Oracle在這個產品分類中指Oracle Database關聯式資料庫管理系統，用來儲存、查詢及管理資料，選C。其餘分別是影像編修、PDF文件及簡報工具，不因能開啟檔案就成為DBMS。",
        "options": {
          "A": "Photoshop主要做影像編修及設計。",
          "B": "Acrobat主要處理PDF文件與表單。",
          "C": "Oracle Database提供資料表、SQL、交易及權限等資料庫功能。",
          "D": "PowerPoint主要用於投影片與簡報。"
        },
        "optionVerdicts": {
          "A": "不選。",
          "B": "不選。",
          "C": "可以選。",
          "D": "不選。"
        },
        "sources": [
